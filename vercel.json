{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/predict", "dest": "/api/predict.py" },
    { "src": "/api/prices", "dest": "/api/prices.py" },
    { "src": "/api/forum", "dest": "/api/forum.py" },
    { "src": "/api/auth", "dest": "/api/auth.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
